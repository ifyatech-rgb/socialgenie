# Database - PostgreSQL (required). Use Supabase or any Postgres host.
# DATABASE_URL: For app runtime. Use pooler (6543) with ?pgbouncer=true for serverless.
# DIRECT_DATABASE_URL: For Prisma migrations (db push, migrate). Use direct connection (5432) - fixes "prepared statement already exists".
# Example pooler: postgresql://postgres:[PASSWORD]@[HOST].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example direct: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST].supabase.co:5432/postgres"

# NextAuth - Required for authentication
# Use http://localhost:3000 for local dev; use your production URL (e.g. https://yourdomain.com) when deployed
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
# For Vercel/proxy: set AUTH_TRUST_HOST=true to fix CLIENT_FETCH_ERROR
AUTH_TRUST_HOST=true

# Google OAuth - Sign in with Google (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase (for auth/admin features, avatars, videos, and production tracking)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Alternative env name (used by some setups and lib/supabase-admin):
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anthropic Claude API (for script generation - REQUIRED)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override model if default fails (e.g. deprecated)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# D-ID API (for AI avatars and video generation)
DID_API_KEY=your-did-api-key-here

# App URL (for callbacks and public URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (7-day free trial + 10 credits signup)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Create a subscription Price in Stripe Dashboard, then paste its ID here (e.g. price_xxx)
STRIPE_PRICE_ID=

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

