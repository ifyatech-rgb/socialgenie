# Database - Required for Prisma (login/signup)
# DATABASE_URL: used by the app at runtime (can use same as direct if not using pooler).
# DIRECT_DATABASE_URL: used by Prisma for db push/migrate (must be direct connection, port 5432).
DIRECT_DATABASE_URL=your_direct_database_url_here

# NextAuth - Required for login/signup
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
# Use true when deployed (e.g. Vercel) so NextAuth trusts request host and avoids CLIENT_FETCH_ERROR
AUTH_TRUST_HOST=true

# Google OAuth - Sign in with Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase - Database and Auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Anthropic Claude - AI Script Generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App URL - Your Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HeyGen API - Avatars, voices, and video generation (add your key from app.heygen.com/settings/api-keys)
HEYGEN_API_KEY=your_heygen_api_key_here

# Replicate API (free avatar generation via SadTalker - alternative to HeyGen $7/avatar)
REPLICATE_API_KEY=your_replicate_api_key_here

# Stripe - Payments & Subscriptions
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_PRICE_ID=your_stripe_price_id_here
# Webhook: Stripe Dashboard → Developers → Webhooks → Add endpoint → Your URL: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
