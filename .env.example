# Database - PostgreSQL (required). Use Supabase or any Postgres host.
# Supabase: Project Settings → Database → Connection string (URI). Replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@ejnqfxncywbgcstubrtq.supabase.co:5432/postgres"

# NextAuth - Required for authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Supabase (for auth/admin features if used)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Anthropic Claude API (for script generation - REQUIRED)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# D-ID API (for AI video generation - REQUIRED)
DID_API_KEY=your-d-id-api-key-here

# HeyGen API (for video generation - alternative to D-ID)
HEYGEN_API_KEY=your-heygen-api-key-here

# Stripe (for payments - add later)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
