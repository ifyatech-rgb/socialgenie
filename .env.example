# Database - PostgreSQL (required). Use Supabase or any Postgres host.
# Supabase pooler (6543): add ?pgbouncer=true to avoid "prepared statement already exists" with Prisma.
# Example: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST].supabase.co:6543/postgres?pgbouncer=true"

# NextAuth - Required for authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Supabase (for auth/admin features, avatars, videos)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Alternative env name (used by some setups):
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anthropic Claude API (for script generation - REQUIRED)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# D-ID API (for AI avatars and video generation)
DID_API_KEY=your-did-api-key-here

# App URL (for callbacks and public URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (7-day free trial + 10 credits signup)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Create a subscription Price in Stripe Dashboard, then paste its ID here (e.g. price_xxx)
STRIPE_PRICE_ID=

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

