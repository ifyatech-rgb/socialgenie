generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["public"]
}

model Profile {
  id             String    @id @db.Uuid
  email          String    @unique
  full_name      String?
  role           String    @default("user")
  credits        Int?
  plan           String?
  avatar_url     String?
  status         String?
  created_at     DateTime? @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  last_active_at DateTime? @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  name                   String?
  image                  String?
  password               String?
  emailVerified          DateTime?
  credits                Int              @default(10)
  plan                   String           @default("trial")
  niche                  String?
  platforms              String?
  onboardingCompleted    Boolean          @default(false)
  avatarId               String?
  avatarUrl              String?
  avatarStatus           String?
  avatarVoiceId          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  payment_status         String           @default("pending")
  stripe_customer_id     String?
  stripe_subscription_id String?
  subscription_status    String?
  customAvatarIds        Json?
  customAvatarsLimit     Int              @default(1)
  customAvatarsUsed      Int              @default(0)
  exportQuality          String           @default("720p")
  genieEdits             Int              @default(5)
  genieEditsUsed         Int              @default(0)
  hasWatermark           Boolean          @default(true)
  maxVideoLength         Int              @default(60)
  videoCredits           Int              @default(3)
  videoCreditsUsed       Int              @default(0)
  accounts               Account[]
  activities             Activity[]
  avatars                Avatar[]
  generatedVideos        GeneratedVideo[]
  onboarding             Onboarding?
  scripts                Script[]
  sessions               Session[]
  subscriptions          Subscription?
  trainingVideos         TrainingVideo[]
  videos                 Video[]

  @@index([email])
  @@index([plan])
  @@schema("public")
}

model Onboarding {
  id                 String   @id @default(cuid())
  userId             String   @unique
  describeYou        String?
  mainGoal           String?
  videosPerMonth     String?
  usedAiTools        String?
  whenPlanningStart  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model TrainingVideo {
  id               String   @id @default(cuid())
  userId           String
  videoUrl         String
  didAvatarId      String?
  processingStatus String   @default("pending")
  processingError  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model Video {
  id        String   @id @default(cuid())
  userId    String
  filename  String
  url       String
  duration  Int?
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scripts   Script[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Script {
  id                String           @id @default(cuid())
  userId            String
  videoId           String?
  topic             String
  platform          String
  tone              String
  length            Int
  content           String
  status            String           @default("generated")
  generatedVideoId  String?
  generatedVideoUrl String?
  videoProvider     String?
  videoStatus       String?
  videoProgress     Int?
  videoError        String?
  projectName       String?
  thumbnailUrl      String?
  duration          Int?
  views             Int              @default(0)
  lastViewedAt      DateTime?
  isFavorite        Boolean          @default(false)
  tags              String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  chatHistory       Json?
  creditCharged     Boolean          @default(false)
  finalizedAt       DateTime?
  lifecycleStatus   String           @default("draft")
  refinementCount   Int              @default(0)
  generatedVideos   GeneratedVideo[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  video             Video?           @relation(fields: [videoId], references: [id])

  @@index([userId])
  @@index([lifecycleStatus])
  @@index([createdAt])
  @@index([userId, lifecycleStatus])
  @@index([userId, createdAt])
  @@schema("public")
}

model GeneratedVideo {
  id                String   @id @default(cuid())
  userId            String
  scriptId          String
  generatedVideoId  String
  generatedVideoUrl String?
  videoProvider     String   @default("heygen")
  videoStatus       String?
  videoProgress     Int?
  videoError        String?
  projectName       String?
  thumbnailUrl      String?
  duration          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  script            Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@schema("public")
}

model Subscription {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  plan                     String
  status                   String
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  trialEndsAt              DateTime?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  paymentMethodFingerprint String?
  duplicatePaymentMethod   Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Avatar {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String
  status         String   @default("processing")
  heygenAvatarId String?
  videoId        String?
  consentVideoId String?
  imageUrl       String?
  videoUrl       String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([heygenAvatarId])
  @@schema("public")
}
