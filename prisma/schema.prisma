// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?   // Hashed password for credentials auth
  emailVerified DateTime?
  credits       Int       @default(10) // Free credits for new users
  plan          String    @default("free") // free, pro, enterprise
  niche         String?   // User's content niche
  platforms     String?   // Comma-separated platforms
  onboardingCompleted Boolean @default(false)
  
  // Custom Avatar (D-ID) - cloned from video
  avatarId      String?   // D-ID agent/presenter ID (from video clone)
  avatarUrl     String?   // Avatar thumbnail or source video URL
  avatarStatus  String?   // pending, processing, ready, failed
  avatarVoiceId String?   // Not used - D-ID clones voice from video
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  videos        Video[]
  scripts       Script[]
  trainingVideos TrainingVideo[]
  subscriptions Subscription?
  activities    Activity[]
}

// Training video uploaded for D-ID avatar cloning (face + voice from video)
model TrainingVideo {
  id                String   @id @default(cuid())
  userId            String
  videoUrl          String   // Public URL of uploaded video
  didAvatarId       String?  // D-ID agent/presenter ID when clone is ready
  processingStatus  String   @default("pending") // pending, processing, completed, failed
  processingError   String?  // Error message if failed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String   // script.generated, video.uploaded, etc.
  details   String?  // JSON string with additional data
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Video {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  url         String
  duration    Int?     // in seconds
  status      String   @default("uploaded") // uploaded, processing, ready, error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts     Script[]
}

model Script {
  id          String   @id @default(cuid())
  userId      String
  videoId     String?
  topic       String
  platform    String   // TikTok, Instagram, YouTube
  tone        String   // Educational, Entertaining, Motivational, Controversial
  length      Int      // in seconds: 30, 60, 90
  content     String   // The generated script
  status      String   @default("generated") // generated, video_processing, video_ready, error
  
  // Generated video fields
  generatedVideoId   String?  // External video ID from D-ID or HeyGen
  generatedVideoUrl  String?  // Final video URL
  videoProvider      String?  // did, heygen
  videoStatus        String?  // pending, processing, completed, failed
  videoError         String?  // Error message if failed
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  plan          String   // basic, pro
  status        String   // active, cancelled, expired
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
