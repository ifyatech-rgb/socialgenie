generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["public"]
}

model accounts {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String    @db.Uuid
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          BigInt?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_account_id])
  @@schema("public")
}

model brand_voice_profiles {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String    @db.Uuid
  name               String
  description        String?
  sample_scripts     String[]
  tone               String?
  sentence_length    String?
  vocabulary_level   String?
  personality_traits String[]
  common_phrases     String[]
  voice_profile      Json?
  is_default         Boolean?  @default(false)
  times_used         Int?      @default(0)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_default], map: "idx_brand_voice_is_default")
  @@index([user_id], map: "idx_brand_voice_user_id")
  @@schema("public")
}

model competitor_analyses {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String    @db.Uuid
  video_url         String
  platform          String?
  views             BigInt?
  likes             Int?
  comments          Int?
  shares            Int?
  transcript        String?
  viral_score       Decimal?  @db.Decimal(3, 1)
  why_viral         String[]
  hook_type         String?
  structure         String?
  key_elements      String[]
  emotion_triggered String?
  script_breakdown  Json?
  analysis_tokens   Int?
  analysis_cost     Decimal?  @db.Decimal(10, 4)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_competitor_analyses_created_at")
  @@index([platform], map: "idx_competitor_analyses_platform")
  @@index([user_id], map: "idx_competitor_analyses_user_id")
  @@schema("public")
}

model cost_logs {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String?   @db.Uuid
  cost_type           String
  ai_model            String?
  tokens_used         Int?
  ai_cost             Decimal?  @db.Decimal(10, 6)
  user_plan           String?
  revenue_allocated   Decimal?  @db.Decimal(10, 6)
  profit              Decimal?  @db.Decimal(10, 6)
  profit_margin       Decimal?  @db.Decimal(5, 2)
  related_entity_type String?
  related_entity_id   String?   @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cost_type], map: "idx_cost_logs_cost_type")
  @@index([created_at], map: "idx_cost_logs_created_at")
  @@index([user_id], map: "idx_cost_logs_user_id")
  @@schema("public")
}

model scripts {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String     @db.Uuid
  topic               String
  platform            String
  content_style       String?
  target_audience     String?
  hook_type           String?
  brand_voice         String?
  cta                 String?
  script_text         String
  hook                String?
  body                String?
  call_to_action      String?
  word_count          Int?
  estimated_duration  Int?
  genie_edits_count   Int?       @default(0)
  chat_history        Json?      @default("[]")
  viral_score         Decimal?   @db.Decimal(3, 1)
  viral_breakdown     Json?
  status              String?    @default("draft")
  is_favorite         Boolean?   @default(false)
  views               Int?
  likes               Int?
  comments            Int?
  shares              Int?
  engagement_rate     Decimal?   @db.Decimal(5, 2)
  ai_model            String?    @default("claude-sonnet-4")
  generation_tokens   Int?
  generation_cost     Decimal?   @db.Decimal(10, 4)
  created_at          DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?  @default(now()) @db.Timestamptz(6)
  finalized_at        DateTime?  @db.Timestamptz(6)
  credit_charged      Boolean?   @default(false)
  lifecycle_status    String?    @default("draft")
  generated_video_id  String?    @map("generated_video_id")
  video_status        String?    @map("video_status")
  generated_video_url String?    @map("generated_video_url")
  video_provider      String?    @map("video_provider")
  video_error         String?    @map("video_error")
  projects            projects[]
  users               users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_scripts_created_at")
  @@index([is_favorite], map: "idx_scripts_is_favorite")
  @@index([platform], map: "idx_scripts_platform")
  @@index([status], map: "idx_scripts_status")
  @@index([user_id], map: "idx_scripts_user_id")
  @@index([viral_score], map: "idx_scripts_viral_score")
  @@schema("public")
}

model sessions {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_token String    @unique
  user_id       String    @db.Uuid
  expires       DateTime  @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model subscription_events {
  id                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                String?   @db.Uuid
  event_type             String
  plan_from              String?
  plan_to                String?
  stripe_subscription_id String?
  stripe_event_id        String?
  stripe_invoice_id      String?
  amount                 Decimal?  @db.Decimal(10, 2)
  currency               String?   @default("usd")
  metadata               Json?
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  users                  users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_subscription_events_created_at")
  @@index([event_type], map: "idx_subscription_events_event_type")
  @@index([user_id], map: "idx_subscription_events_user_id")
  @@schema("public")
}

model user_activity_log {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String?   @db.Uuid
  activity_type String
  description   String?
  ip_address    String?   @db.Inet
  user_agent    String?
  metadata      Json?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activity_type], map: "idx_activity_log_activity_type")
  @@index([created_at], map: "idx_activity_log_created_at")
  @@index([user_id], map: "idx_activity_log_user_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                          String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                       String                 @unique
  name                        String?
  password_hash               String?
  email_verified              Boolean?               @default(false)
  image                       String?
  plan                        String?                @default("trial")
  plan_status                 String?                @default("trialing")
  plan_start_date             DateTime?              @db.Timestamptz(6)
  trial_ends_at               DateTime?              @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(6)
  scripts_per_month           Int?                   @default(5)
  scripts_remaining           Int?                   @default(5)
  scripts_used_this_month     Int?                   @default(0)
  scripts_total_generated     Int?                   @default(0)
  genie_edits_per_script      Int?                   @default(5)
  genie_edits_used_this_month Int?                   @default(0)
  max_script_length           Int?                   @default(45)
  viral_score_predictor       Boolean?               @default(false)
  competitor_analysis         Boolean?               @default(false)
  brand_voice_training        Boolean?               @default(false)
  trend_scanner               Boolean?               @default(false)
  multi_variants              Boolean?               @default(false)
  performance_tracker         Boolean?               @default(false)
  batch_generation            Boolean?               @default(false)
  content_calendar            Boolean?               @default(false)
  api_access                  Boolean?               @default(false)
  competitor_analysis_limit   Int?                   @default(0)
  competitor_analysis_used    Int?                   @default(0)
  brand_voice_profiles_limit  Int?                   @default(0)
  brand_voice_profiles_used   Int?                   @default(0)
  variants_count              Int?                   @default(0)
  batch_size                  Int?                   @default(0)
  stripe_customer_id          String?                @unique
  stripe_subscription_id      String?
  stripe_price_id             String?
  onboarding_completed        Boolean?               @default(false)
  niche                       String?
  platform                    String?
  main_challenge              String?
  created_at                  DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?              @default(now()) @db.Timestamptz(6)
  last_login_at               DateTime?              @db.Timestamptz(6)
  avatar_status               String?
  avatar_url                  String?
  credits                     Int?                   @default(10)
  custom_avatars_limit        Int?                   @default(1)
  custom_avatars_used         Int?                   @default(0)
  genie_edits                 Int?                   @default(25)
  payment_status              String?
  video_credits               Int?                   @default(10)
  video_credits_used          Int?                   @default(0)
  accounts                    accounts[]
  brand_voice_profiles        brand_voice_profiles[]
  competitor_analyses         competitor_analyses[]
  cost_logs                   cost_logs[]
  projects                    projects[]
  scripts                     scripts[]
  sessions                    sessions[]
  subscription_events         subscription_events[]
  user_activity_log           user_activity_log[]

  @@index([created_at], map: "idx_users_created_at")
  @@index([email], map: "idx_users_email")
  @@index([plan], map: "idx_users_plan")
  @@index([plan_status], map: "idx_users_plan_status")
  @@index([stripe_customer_id], map: "idx_users_stripe_customer")
  @@index([stripe_subscription_id], map: "idx_users_stripe_subscription")
  @@schema("public")
}

model projects {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @map("user_id") @db.Uuid
  name             String
  description      String?
  script_id        String?   @map("script_id") @db.Uuid
  script_text      String    @map("script_text")
  avatar_id        String    @map("avatar_id")
  avatar_name      String    @map("avatar_name")
  avatar_look      String?   @map("avatar_look")
  is_talking_photo Boolean? @default(false) @map("is_talking_photo")
  status           String?   @default("pending")
  video_id         String?   @map("video_id")
  video_url        String?   @map("video_url")
  thumbnail_url    String?   @map("thumbnail_url")
  error_message    String?   @map("error_message")
  provider_error   String?   @map("provider_error")
  retry_count      Int?      @default(0) @map("retry_count")
  credits_used     Int?      @default(5) @map("credits_used")
  credits_refunded Boolean?  @default(false) @map("credits_refunded")
  duration         Int?
  platform         String?
  created_at       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  completed_at     DateTime? @map("completed_at") @db.Timestamptz(6)
  failed_at        DateTime? @map("failed_at") @db.Timestamptz(6)
  scripts          scripts?  @relation(fields: [script_id], references: [id], onUpdate: NoAction)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_projects_user_id")
  @@index([status], map: "idx_projects_status")
  @@index([video_id], map: "idx_projects_video_id")
  @@index([created_at], map: "idx_projects_created_at")
  @@schema("public")
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@schema("public")
}

/// Cache of HeyGen avatars with real default voice IDs (synced from HeyGen API).
/// Never use display labels like "Default Voice" as voice_id — always use real HeyGen IDs from here.
model heygen_avatar_cache {
  heygen_avatar_id   String   @unique @map("heygen_avatar_id")
  display_name       String   @map("display_name")
  default_voice_id   String   @map("default_voice_id")
  default_voice_name String   @map("default_voice_name")
  preview_url        String?  @map("preview_url")
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("heygen_avatar_cache")
  @@schema("public")
}
